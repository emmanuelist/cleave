# Cleave — testnet only. This project spends zero dollars.

NETWORK=testnet

# Endpoints. Defaults are baked into src/config.ts; override only to use your own.
# INDEXER_URL is the one that MOVES — the demo stack has relocated before.
# If preflight reports zero markets, suspect this first.
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# RPC_URL=https://api.infra.testnet.somnia.network
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Venue scope. REQUIRED for trading, and it MOVES — testnet changed venue three
# times in the first week of August 2026. Leave unset and run `npm run preflight`:
# it reads the live venue ids off actual market rows instead of guessing.
VENUE_ID=

# Signer. Read-only preflight does not need this. A trading run does.
# Use a FRESH keypair dedicated to this project, never a personal wallet.
PRIVATE_KEY=

# Safety. Never flip this to false without reading src/ first.
DRY_RUN=true
